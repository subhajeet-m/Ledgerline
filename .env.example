# Copy this file to .env and fill in real values.
# Real secrets live only in .env / .env.local, both gitignored — never commit actual values here.

# Postgres (Neon) — used by the app via Prisma.
# DATABASE_URL: pooled connection (PgBouncer, "-pooler" host) — used by the running app.
# DATABASE_URL_UNPOOLED: direct connection (no "-pooler") — used by prisma7.config.ts for
# migrate/introspect/studio, since the pooler doesn't support session-level operations.
NEON_BRANCH=production
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Auth (lib/auth.ts) — used to sign/verify JWT access and refresh tokens.
# Generate strong random values, e.g. `openssl rand -base64 32`. Never reuse between the two.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"

# Upstash Redis (lib/redis.ts) — used for idempotency keys and rate limiting.
# Read automatically by @upstash/redis's Redis.fromEnv(); create a database at console.upstash.com.
UPSTASH_REDIS_REST_URL="https://example-12345.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-your-upstash-rest-token"
